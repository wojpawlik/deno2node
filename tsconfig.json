{
  "include": ["src/"],
  "deno2node": {
    "shim": "src/shim.node.ts"
  },
  "compilerOptions": {
    "declaration": true,
    "module": "esnext",
    "noEmitOnError": true,
    "outDir": "lib/",
    "rootDir": "src/",
    "skipLibCheck": true, // speed
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  }
}
